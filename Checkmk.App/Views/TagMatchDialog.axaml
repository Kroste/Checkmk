<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        xmlns:svc="using:Checkmk.App.Services"
        x:Class="Checkmk.App.Views.TagMatchDialog"
        Width="760" Height="600"
        Title="Tags zuordnen"
        WindowStartupLocation="CenterOwner">

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,Auto,Auto,*,Auto">

      <controls:TitleBar Grid.Row="0" Title="Tags zuordnen" />

      <TextBlock Grid.Row="1" Name="PromptText" Margin="16,12,16,0"
                 Foreground="#AAAAAA" TextWrapping="Wrap" />

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="16,10,16,6">
        <TextBox Grid.Column="0" Name="FilterBox" PlaceholderText="Filter (Tag oder Bereich)…" />
        <CheckBox Grid.Column="1" Name="OnlyChangesBox" Content="nur Änderungen" IsChecked="True"
                  ToolTip.Tip="Blendet Bereiche aus, die diesen Tag bereits tragen." />
        <Button Grid.Column="2" Content="Alle sichtbaren" Click="OnSelectVisibleClick" />
        <Button Grid.Column="3" Content="Keine" Click="OnSelectNoneClick" />
      </Grid>

      <ListBox Grid.Row="3" Name="MatchList" Margin="16,0,16,0"
               SelectionMode="Multiple,Toggle">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="svc:TagMatch">
            <Grid ColumnDefinitions="170,70,*,Auto" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding TagValue}" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding HostCount, StringFormat='{}{0} Hosts'}"
                         FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding AreaName}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Note}" FontSize="12"
                         Foreground="#AAAAAA" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="16">
        <TextBlock Grid.Column="0" Name="CountText" VerticalAlignment="Center"
                   Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" />
        <Button Grid.Column="1" Content="Übernehmen" Click="OnOkClick"
                Background="#123E6B" IsDefault="True" />
        <Button Grid.Column="2" Content="Abbrechen" Click="OnCancelClick" IsCancel="True" />
      </Grid>
    </Grid>
  </Border>
</controls:ChromeWindow>
