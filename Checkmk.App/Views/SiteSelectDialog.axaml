<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        x:Class="Checkmk.App.Views.SiteSelectDialog"
        Width="460" Height="320"
        Title="Sichtbar in Sites"
        WindowStartupLocation="CenterOwner">

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,*,Auto">

      <controls:TitleBar Grid.Row="0" Name="DialogTitleBar" Title="Sichtbar in Sites" />

      <StackPanel Grid.Row="1" Margin="16" Spacing="8">
        <TextBlock Name="PromptText" TextWrapping="Wrap" />
        <TextBlock Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                   Text="Nichts angehakt = in allen Sites sichtbar. Das ist der Ausgangszustand älterer Bereiche und gilt auch nach einer späteren Zusammenführung der Sites." />
        <ItemsControl Name="SiteList" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding}" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="16" Spacing="8">
        <Button Content="Speichern" Click="OnOkClick" Background="#123E6B" IsDefault="True" />
        <Button Content="Abbrechen" Click="OnCancelClick" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Border>
</controls:ChromeWindow>
