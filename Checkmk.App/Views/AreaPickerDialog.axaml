<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        x:Class="Checkmk.App.Views.AreaPickerDialog"
        Width="460" Height="300"
        Title="Bereich auswählen"
        WindowStartupLocation="CenterOwner">

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,*,Auto">

      <controls:TitleBar Grid.Row="0" Title="Bereich auswählen" />

      <StackPanel Grid.Row="1" Margin="16" Spacing="10">
        <TextBlock Name="PromptText" Foreground="#AAAAAA" TextWrapping="Wrap" />
        <ComboBox Name="AreaBox" HorizontalAlignment="Stretch"
                  PlaceholderText="Bereich wählen" />
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="16" Spacing="8">
        <!-- Eigener Knopf statt „Bereich = keiner" in der Liste: Entfernen ist
             eine andere Absicht als Zuweisen und soll nicht aus Versehen
             getroffen werden. -->
        <Button Name="ClearButton" Content="Zuordnung entfernen" Click="OnClearClick" />
        <Button Content="OK" Click="OnOkClick" Background="#123E6B" IsDefault="True" />
        <Button Content="Abbrechen" Click="OnCancelClick" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Border>
</controls:ChromeWindow>
