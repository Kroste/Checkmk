<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        x:Class="Checkmk.App.Views.HostMultiSelectDialog"
        Width="520" Height="520"
        Title="Hosts auswählen"
        WindowStartupLocation="CenterOwner">

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,Auto,Auto,*,Auto">

      <controls:TitleBar Grid.Row="0" Name="DialogTitleBar" Title="Hosts auswählen" />

      <TextBlock Grid.Row="1" Name="PromptText" Margin="16,12,16,0"
                 Foreground="#AAAAAA" TextWrapping="Wrap" />

      <!-- Freitextfilter: bei über tausend Hosts ist Scrollen keine Bedienung.
           Regex-Fälle deckt der Host-Filter im Status-Tab ab; hier reicht
           Contains. -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="16,10,16,6">
        <TextBox Grid.Column="0" Name="FilterBox"
                 PlaceholderText="Filter (Teil des Hostnamens)…" />
        <Button Grid.Column="1" Content="Alle sichtbaren" Click="OnSelectVisibleClick" />
        <Button Grid.Column="2" Content="Keine" Click="OnSelectNoneClick" />
      </Grid>

      <ListBox Grid.Row="3" Name="HostList" Margin="16,0,16,0"
               SelectionMode="Multiple,Toggle" />

      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="16">
        <TextBlock Grid.Column="0" Name="CountText" VerticalAlignment="Center"
                   Foreground="#AAAAAA" FontSize="12" />
        <Button Grid.Column="1" Content="OK" Click="OnOkClick"
                Background="#123E6B" IsDefault="True" />
        <Button Grid.Column="2" Content="Abbrechen" Click="OnCancelClick" IsCancel="True" />
      </Grid>
    </Grid>
  </Border>
</controls:ChromeWindow>
