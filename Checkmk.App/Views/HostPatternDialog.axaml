<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        x:Class="Checkmk.App.Views.HostPatternDialog"
        Width="560" Height="520"
        Title="Host-Muster"
        WindowStartupLocation="CenterOwner">

  <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1E1E1E">
    <Grid RowDefinitions="40,Auto,Auto,*,Auto">

      <controls:TitleBar Grid.Row="0" Name="DialogTitleBar" Title="Host-Muster" />

      <StackPanel Grid.Row="1" Margin="16,12,16,0" Spacing="6">
        <TextBlock Name="PromptText" TextWrapping="Wrap" />
        <TextBlock Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                   Text="Regulärer Ausdruck auf den Hostnamen, Groß-/Kleinschreibung egal. Für Schulen aus der Schulnummer vorbelegt: (?&lt;!\d)46(?!\d) trifft 46-SW04, NAS46-01 und iRMC-46, aber nicht 146-SW01." />
        <TextBox Name="PatternBox" PlaceholderText="z. B. (?&lt;!\d)46(?!\d) oder stadthaus" />
        <TextBlock Name="StateText" FontSize="12" />
      </StackPanel>

      <TextBlock Grid.Row="2" Text="Treffer:" Margin="16,10,16,4" FontWeight="SemiBold" />

      <ListBox Grid.Row="3" Name="MatchList" Margin="16,0,16,0" />

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="16" Spacing="8">
        <Button Content="Muster entfernen" Click="OnClearClick" />
        <Button Content="Speichern" Click="OnOkClick" Background="#123E6B" IsDefault="True" />
        <Button Content="Abbrechen" Click="OnCancelClick" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Border>
</controls:ChromeWindow>
