<controls:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Checkmk.App.Controls"
        xmlns:vm="using:Checkmk.App.ViewModels"
        xmlns:views="using:Checkmk.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Checkmk.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1000" Height="680"
        MinWidth="720" MinHeight="480"
        Title="{Binding AppTitle, FallbackValue='Checkmk Cockpit'}"
        WindowStartupLocation="CenterScreen">

  <Border BorderBrush="#3A3A3A" BorderThickness="1"
          Background="{DynamicResource KrosteBackgroundBrush}">
    <Grid RowDefinitions="40,*,26">

      <controls:TitleBar Grid.Row="0" Title="{Binding AppTitle, FallbackValue='Checkmk Cockpit'}">
        <controls:TitleBar.Extras>
          <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <Border Background="{DynamicResource KrosteAccentBrush}" CornerRadius="3" Padding="6,1"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip.Tip="Ziel-Backend: Checkmk 2.5, REST-API v1">
              <TextBlock Text="2.5 · v1" FontSize="11" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        Margin="0,0,12,0" IsVisible="{Binding IsSiteSwitcherVisible}">
              <TextBlock Text="Site:" Foreground="#AAAAAA" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding KnownSites}"
                        SelectedItem="{Binding ActiveSite, Mode=TwoWay}"
                        MinWidth="140" VerticalAlignment="Center"
                        ToolTip.Tip="Zwischen bekannten Sites am gleichen Server umschalten (Host/User/Secret bleiben)." />
            </StackPanel>
            <Button Content="Einstellungen" Command="{Binding OpenSettingsCommand}"
                    IsVisible="{Binding ShowSettings}"
                    Background="Transparent" Padding="12,0" />
            <Button Content="Über" Command="{Binding OpenAboutCommand}"
                    Background="Transparent" Padding="12,0" />
          </StackPanel>
        </controls:TitleBar.Extras>
      </controls:TitleBar>

      <!-- Inhalt -->
      <TabControl Name="MainTabs" Grid.Row="1" Margin="8">
        <TabItem Header="Status">
          <views:StatusView DataContext="{Binding Status}" />
        </TabItem>
        <!-- Hosts + Dashboard werden im Viewer-Modus in MainWindow.axaml.cs entfernt.
             Bewusst Code-Behind statt IsVisible: ein unsichtbarer TabItem bleibt
             per Ctrl+Tab erreichbar. -->
        <TabItem Name="HostsTab" Header="Hosts">
          <views:ConfigView DataContext="{Binding Config}" />
        </TabItem>
        <!-- Bereiche gibt es nur mit zentraler Datenbank — ohne sie wird der Tab
             in MainWindow.axaml.cs entfernt (nicht versteckt, sonst bleibt er
             per Ctrl+Tab erreichbar). -->
        <TabItem Name="AreasTab" Header="Bereiche">
          <views:AreaView Name="AreasView" />
        </TabItem>
        <TabItem Name="DashboardTab" Header="Dashboard">
          <views:DashboardView DataContext="{Binding Dashboard}" />
        </TabItem>
      </TabControl>

      <!-- Statusleiste -->
      <Border Grid.Row="2" Background="#123E6B">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="10,0">
          <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                  VerticalAlignment="Center" Margin="0,0,8,0"
                  Background="{Binding Status.IsBackendHealthy, Converter={StaticResource BoolToHealthBrush}}"
                  ToolTip.Tip="Backend-Verbindung: grün = letzter Refresh erfolgreich, rot = Fehler." />
          <!-- Fortschritt des Refreshs. Nur waehrend des Ladens sichtbar; der
               Nenner ist die Antwortgroesse des letzten Laufs, weil Checkmk die
               grossen Livestatus-Antworten ohne Content-Length schickt. Fehlt der
               Schaetzer (allererster Lauf), laeuft der Balken als Marquee. -->
          <ProgressBar Grid.Column="1" Width="120" Height="8"
                       VerticalAlignment="Center" Margin="0,0,10,0"
                       Minimum="0" Maximum="1"
                       Value="{Binding Status.RefreshProgress}"
                       IsIndeterminate="{Binding Status.RefreshIndeterminate}"
                       IsVisible="{Binding Status.IsBusy}"
                       ToolTip.Tip="Fortschritt des laufenden Abrufs." />
          <TextBlock Grid.Column="2" Text="{Binding Status.StatusMessage}"
                     VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Text="{Binding Status.FilterInfo}"
                     VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0"
                     Foreground="#B5D0EA" />
          <!-- Nur sichtbar, wenn die zentralen Einstellungen NICHT frisch aus
               der Datenbank kommen. Wer mit einem Cache-Stand arbeitet, soll das
               sehen, bevor er sich wundert, warum eine zentrale Änderung fehlt. -->
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8"
                      VerticalAlignment="Center" Margin="10,0,0,0">
            <!-- Schema-Warnung: Anwendung und Datenbank passen nicht zusammen.
                 Rot, weil das ein Admin beheben muss (Skript aus db/ fehlt) —
                 sonst scheitert später ein Zugriff mit einer Meldung über eine
                 fehlende Spalte und niemand kommt auf die Ursache. -->
            <Border Background="#B3261E" CornerRadius="3" Padding="8,1"
                    IsVisible="{Binding HasSchemaWarning}"
                    ToolTip.Tip="{Binding SchemaWarning}">
              <TextBlock Text="Datenbank-Schema veraltet" FontSize="12" />
            </Border>
            <Border Background="#8D6E13" CornerRadius="3" Padding="8,1"
                    IsVisible="{Binding HasCentralInfo}"
                    ToolTip.Tip="{Binding CentralInfo}">
              <TextBlock Text="Zentral: Cache" FontSize="12" />
            </Border>
          </StackPanel>
          <Button Grid.Column="5" Content="{Binding UpdateBadge}"
                  Command="{Binding OpenUpdateCommand}"
                  IsVisible="{Binding HasUpdate}"
                  Background="#F9A825" Foreground="#000000"
                  Padding="10,2" Margin="8,0,10,0" FontSize="12" FontWeight="SemiBold"
                  ToolTip.Tip="Klicken für Release-Notes und Download-Link." />
          <TextBlock Grid.Column="6" Text="{Binding ConnectionInfo}"
                     VerticalAlignment="Center" FontSize="12" Margin="10,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</controls:ChromeWindow>
